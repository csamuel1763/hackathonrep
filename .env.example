# ─────────────────────────────────────────────────────────────────────────────
# CareerPilot AI — Environment Variables Template
# Copy this file to .env and fill in all values before running the application.
# NEVER commit the actual .env file to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ─────────────────────
# Application
# ─────────────────────
APP_ENV=development
# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ─────────────────────
# PostgreSQL Database
# ─────────────────────
POSTGRES_DB=careerpilot
POSTGRES_USER=careerpilot
POSTGRES_PASSWORD=careerpilot_secret

# Full async connection URL — used by SQLAlchemy inside the backend container.
# In Docker Compose, the hostname is the service name "db".
# For local development (outside Docker), use "localhost" instead.
DATABASE_URL=postgresql+asyncpg://careerpilot:careerpilot_secret@db:5432/careerpilot

# ─────────────────────
# JWT Authentication
# ─────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET_KEY=CHANGE_ME_generate_a_strong_secret_before_deploying
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ─────────────────────
# Ollama Local AI LLM
# ─────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# ─────────────────────
# File Upload
# ─────────────────────
# Absolute path inside the backend container
UPLOAD_DIR=/app/uploads
# Maximum allowed resume file size in megabytes
MAX_FILE_SIZE_MB=10

# ─────────────────────
# Taxonomy
# ─────────────────────
# Path to the cybersecurity taxonomy JSON (relative to project root)
TAXONOMY_FILE_PATH=taxonomy/roles.json

# ─────────────────────
# pgAdmin (dev only)
# ─────────────────────
PGADMIN_EMAIL=admin@careerpilot.dev
PGADMIN_PASSWORD=pgadmin_secret
